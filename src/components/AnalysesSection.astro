---
import { useTranslations } from '../i18n/utils';
import { analyses as allAnalyses, getHref } from '../data/analyses';

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? 'cs';

/** Max number of analyses shown on landing page. Rest lives in /analyses/ archive. */
const MAX_FEATURED = 4;

/** Live analyses always shown first; within each group, original array order is preserved. */
const analyses = [...allAnalyses]
  .sort((a, b) => (a.live === b.live ? 0 : a.live ? -1 : 1))
  .slice(0, MAX_FEATURED);

/** Obálky karet pro českou verzi: číslo a věta vycházejí z názvu a perexu analýzy, žádný nový údaj. */
const covers: Record<string, { n: string; t: string; slovo?: boolean }> = locale === 'en' ? {} : {
  'potravinovy-sok': { n: '6 bran', t: 'mezi cenou močoviny a\u00a0nákupním košíkem' },
  'rhine-kaub': { n: '8 cm', t: 'nejcitovanější číslo léta 2026 na Rýně' },
  'opportunity-threat': { n: 'Výzva, nebo ohrožení?', t: 'jak mozek přepíná pod tlakem', slovo: true },
  'index-regionu': { n: '206 obvodů', t: '49\u00a0ukazatelů kvality života v\u00a0českých městech' },
};
---

<section class="analyses container" id="analyzy">
  <div class="section-header reveal">
    <div class="section-tag">{t('nav.analyses')}</div>
    <h2 set:html={t('analyses.title')} />
    <p class="section-lead">{t('analyses.subtitle')}</p>
  </div>

  <div class="analyses-stack">
    {analyses.map((analysis, i) => (
      <a
        href={getHref(analysis, locale)}
        class={`analysis-card reveal${i > 0 ? ` reveal-delay-${i}` : ''}`}
      >
        {covers[analysis.key] ? (
          /* Obálka v jednom stylu: ztmavený tematický záběr (Mixkit), přes něj jedno číslo a jedna věta. */
          <div class="card-cover" aria-hidden="true" style={`background-image: linear-gradient(180deg, rgba(13,37,61,.28) 0%, rgba(13,37,61,.5) 42%, rgba(13,37,61,.92) 82%), url(/images/obalky/${analysis.key}.jpg)`}>
            <strong class={covers[analysis.key].slovo ? 'cover-num cover-word' : 'cover-num'}>{covers[analysis.key].n}</strong>
            <span class="cover-text">{covers[analysis.key].t}</span>
          </div>
        ) : (
        <div class="card-image">
          <img
            src={analysis.image}
            alt={t(`analyses.${analysis.key}.title`)}
            loading="lazy"
            width="800"
            height="500"
          />
        </div>
        )}
        <div class="card-content">
          <div class="card-meta">
            <div class="card-tags">
              {analysis.tags.map((tag) => (
                <span>{t(tag)}</span>
              ))}
            </div>
          </div>
          <h3>{t(`analyses.${analysis.key}.title`)}</h3>
          <p class="card-desc" set:html={t(`analyses.${analysis.key}.desc`)} />
          <p class="card-why">{t(`analyses.${analysis.key}.why`)}</p>
          <span class="card-cta">
            {t(`analyses.${analysis.key}.cta`)}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </div>
      </a>
    ))}
  </div>

  <div class="analyses-footer reveal">
    <a href={locale === 'en' ? '/en/analyses/' : '/analyses/'} class="analyses-all">
      {t('archive.explore.all')}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>
</section>

<style>
  /* Section header */
  .section-tag {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-section-tag);
    margin-bottom: var(--space-sm);
  }

  .section-header {
    margin-bottom: var(--space-xl);
  }

  .section-header h2 {
    font-family: var(--font-serif);
    max-width: 700px;
  }

  .section-lead {
    max-width: 600px;
    color: var(--color-muted);
    margin-top: var(--space-xs);
    line-height: 1.6;
  }

  .analyses {
    padding-top: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  /* Card stack */
  .analyses-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* Card */
  .analysis-card {
    display: grid;
    grid-template-columns: 2fr 3fr;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    overflow: hidden;
    text-decoration: none;
    color: var(--color-text);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .analysis-card:hover {
    color: var(--color-text);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
  }

  .card-cover {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.6rem;
    min-height: 240px;
    padding: 1.6rem 1.7rem;
    background: #102d47 center / cover no-repeat;
    border-left: 4px solid #2aa3b0;
    color: #ffffff;
  }
  .cover-num { font-family: var(--font-serif); font-weight: 400; font-size: clamp(2.6rem, 4.4vw, 3.6rem); line-height: 1; letter-spacing: -0.035em; color: #ffffff; }
  .cover-word { font-size: clamp(1.7rem, 2.6vw, 2.2rem); line-height: 1.1; }
  .cover-text { font-size: 0.98rem; line-height: 1.45; color: #c9d6e0; max-width: 26ch; }

  /* Card image */
  .card-image {
    position: relative;
    min-height: 260px;
    overflow: hidden;
    background: linear-gradient(
      135deg,
      var(--color-surface-elevated) 0%,
      color-mix(in srgb, var(--color-accent) 6%, var(--color-surface)) 100%
    );
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    display: block;
    transition: transform 0.4s ease;
  }

  .analysis-card:hover .card-image img {
    transform: scale(1.03);
  }

  /* Card content */
  .card-content {
    padding: var(--space-lg) var(--space-xl);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .card-tags span {
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-border) 60%, transparent);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .card-badge {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border-radius: 100px;
    background: var(--gradient-accent);
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .card-content h3 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 500;
    margin-bottom: var(--space-xs);
    line-height: 1.3;
  }

  .card-desc {
    font-family: var(--font-sans);
    line-height: 1.6;
    margin-bottom: var(--space-xs);
  }

  .card-why {
    font-family: var(--font-sans);
    font-style: italic;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: var(--space-md);
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.2rem;
    border-radius: 8px;
    background: var(--color-accent);
    color: white;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    width: fit-content;
    transition: gap 0.2s ease, background 0.2s ease;
  }

  .analysis-card:hover .card-cta {
    gap: 0.8rem;
  }

  /* Footer link */
  .analyses-footer {
    text-align: center;
    margin-top: var(--space-lg);
  }
  .analyses-all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.2s, gap 0.2s;
  }
  .analyses-all:hover {
    color: var(--color-accent-hover);
    gap: 0.8rem;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .analysis-card {
      grid-template-columns: 1fr;
    }

    .card-image {
      min-height: 200px;
      max-height: 240px;
    }

    .card-content {
      padding: var(--space-md);
    }
  }

  @media (max-width: 640px) {
    .card-image {
      min-height: 160px;
      max-height: 200px;
    }

    .card-content {
      padding: var(--space-sm);
    }

    .card-content h3 {
      font-size: 1.2rem;
    }

    .card-cta {
      padding: 0.65rem 1.2rem;
      min-height: 44px;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 400px) {
    .card-image {
      min-height: 140px;
      max-height: 180px;
    }
  }
</style>
