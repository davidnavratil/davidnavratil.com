---
/**
 * Archiv analýz (/analyses/ a /en/analyses/). Jeden zdroj pro obě jazykové verze.
 * Karty mají stejný jazyk jako na úvodní stránce: obálka s číslem, kde ji analýza má,
 * jinak tmavý panel s ztlumeným náhledem. Žádné zelené štítky, pilulky ani stíny.
 *
 * DEPLOYMENT NOTE: The /analyses/ directory on the server already contains
 * subdirectories served by nginx; rsync in deploy.yml excludes them.
 */
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n/utils';
import { analyses, getHref } from '../data/analyses';
import { getObalky, obalkaBg } from '../data/obalky';

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? 'cs';
const covers = getObalky(locale);

const allTags = [...new Set(analyses.flatMap((a) => a.tags))];

const mesice = locale === 'en'
  ? ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
  : ['leden', 'únor', 'březen', 'duben', 'květen', 'červen', 'červenec', 'srpen', 'září', 'říjen', 'listopad', 'prosinec'];
const datum = (d: string) => {
  const [y, m] = d.split('-');
  const i = Number(m) - 1;
  return mesice[i] ? `${mesice[i]} ${y}` : d;
};
const druh = locale === 'en' ? 'Interactive analysis' : 'Interaktivní analýza';
---

<Base
  title={`${t('archive.title')} · David Navrátil`}
  description={t('archive.subtitle')}
>
  <section class="archive-back container">
    <a href={locale === 'en' ? '/en/' : '/'} class="back-link">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      {t('archive.back')}
    </a>
  </section>

  <section class="archive-hero container">
    <div class="archive-hero-inner">
      <div class="section-tag">{t('nav.analyses')}</div>
      <h1>{t('archive.title')}</h1>
      <p class="archive-lead">{t('archive.subtitle')}</p>
    </div>
  </section>

  <section class="archive-filters container">
    <div class="filter-bar" role="group" aria-label={locale === 'en' ? 'Filter by topic' : 'Filtrovat podle tématu'}>
      <button class="filter-tag active" data-tag="all" aria-pressed="true">
        {locale === 'en' ? 'All' : 'Vše'}
      </button>
      {allTags.map((tag) => (
        <button class="filter-tag" data-tag={tag} aria-pressed="false">
          {t(tag)}
        </button>
      ))}
    </div>
  </section>

  <section class="archive-grid container">
    {analyses.map((analysis) => {
      const c = covers[analysis.key];
      const title = t(`analyses.${analysis.key}.title`);
      const Tag = analysis.live ? 'a' : 'article';
      return (
        <Tag
          class={`archive-card${analysis.live ? '' : ' archive-card--coming'}`}
          href={analysis.live ? getHref(analysis, locale) : undefined}
          data-tags={analysis.tags.join(',')}
          data-live={analysis.live ? 'true' : 'false'}
        >
          {c ? (
            <div class="card-cover" aria-hidden="true" style={obalkaBg(analysis.key)}>
              <strong class={c.slovo ? 'cover-num cover-word' : 'cover-num'}>{c.n}</strong>
              <span class="cover-text">{c.t}</span>
            </div>
          ) : (
            <div class="card-shot" aria-hidden="true">
              <img src={analysis.image} alt="" loading="lazy" width="800" height="500" />
              <span class="shot-label">{druh}</span>
            </div>
          )}
          <div class="archive-card-body">
            <div class="archive-card-meta">
              <time datetime={analysis.date}>{datum(analysis.date)}</time>
              <div class="archive-card-tags">
                {analysis.tags.map((tag) => <span>{t(tag)}</span>)}
              </div>
            </div>
            <h2>{title}</h2>
            <p class="archive-card-desc" set:html={t(`analyses.${analysis.key}.desc`)} />
            <p class="archive-card-why">{t(`analyses.${analysis.key}.why`)}</p>
            {analysis.live ? (
              <span class="archive-card-cta">
                {t(`analyses.${analysis.key}.cta`)}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            ) : (
              <span class="archive-card-soon">{t('archive.status.coming')}</span>
            )}
          </div>
        </Tag>
      );
    })}
  </section>

  <section class="archive-newsletter band">
    <div class="container archive-newsletter-inner">
      <div>
        <h2>{t('archive.newsletter.title')}</h2>
        <p>{t('newsletter.desc')}</p>
      </div>
      <a href="https://davidnavratil.substack.com" target="_blank" rel="noopener" class="archive-newsletter-btn">
        {t('archive.newsletter.cta')}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>
</Base>

<style>
  .archive-back {
    padding-top: calc(80px + var(--space-lg));
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
  }
  .back-link:hover { color: var(--color-accent); }

  .archive-hero {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-lg);
  }
  .archive-hero-inner { max-width: 720px; }
  .section-tag {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-section-tag);
    margin-bottom: var(--space-sm);
  }
  .archive-hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    margin-bottom: var(--space-sm);
  }
  .archive-lead {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 600px;
  }

  /* Filtr: hranaté přepínače, aktivní v plné barvě */
  .archive-filters { padding-bottom: var(--space-lg); }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .filter-tag {
    min-height: 36px;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .filter-tag:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .filter-tag.active {
    background: var(--color-accent-bg);
    border-color: var(--color-accent-bg);
    color: #fff;
  }

  /* Karty */
  .archive-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-bottom: var(--space-2xl);
  }
  .archive-card {
    display: grid;
    grid-template-columns: 2fr 3fr;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    overflow: hidden;
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.2s;
  }
  a.archive-card:hover {
    color: var(--color-text);
    border-color: color-mix(in srgb, var(--color-accent) 50%, var(--color-border));
  }
  .archive-card.hidden { display: none; }

  .card-cover {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.6rem;
    min-height: 260px;
    padding: 1.6rem 1.7rem;
    background: #102d47 center / cover no-repeat;
    border-left: 4px solid #2aa3b0;
    color: #fff;
  }
  .cover-num { font-family: var(--font-serif); font-weight: 400; font-size: clamp(2.6rem, 4.4vw, 3.6rem); line-height: 1; letter-spacing: -0.035em; color: #fff; }
  .cover-word { font-size: clamp(1.7rem, 2.6vw, 2.2rem); line-height: 1.1; }
  .cover-text { font-size: 0.98rem; line-height: 1.45; color: #c9d6e0; max-width: 26ch; }

  /* Analýza bez obálky: tmavý panel, náhled ztlumený do modré, aby karty držely pohromadě */
  .card-shot {
    position: relative;
    min-height: 260px;
    background: #102d47;
    border-left: 4px solid #2aa3b0;
    overflow: hidden;
  }
  .card-shot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    filter: grayscale(1) contrast(1.05);
    mix-blend-mode: luminosity;
    opacity: 0.3;
  }
  .card-shot::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(13,37,61,.15) 0%, rgba(13,37,61,.55) 55%, rgba(13,37,61,.95) 100%);
  }
  .shot-label {
    position: absolute;
    left: 1.7rem;
    bottom: 1.5rem;
    z-index: 1;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #8dd4cb;
  }
  .archive-card--coming .card-shot img { opacity: 0.18; }

  .archive-card-body {
    padding: var(--space-lg) var(--space-xl);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .archive-card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
  }
  .archive-card-meta time {
    font-size: 0.78rem;
    color: var(--color-muted);
  }
  .archive-card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .archive-card-tags span {
    padding: 0.15rem 0.55rem;
    background: color-mix(in srgb, var(--color-border) 60%, transparent);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }
  .archive-card-body h2 {
    font-size: clamp(1.35rem, 2.2vw, 1.6rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-xs);
  }
  .archive-card-desc {
    line-height: 1.6;
    margin-bottom: var(--space-xs);
  }
  .archive-card-why {
    font-style: italic;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: var(--space-md);
  }
  .archive-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0.5rem 1.2rem;
    background: var(--color-accent-bg);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    width: fit-content;
    transition: gap 0.2s;
  }
  a.archive-card:hover .archive-card-cta { gap: 0.8rem; }
  .archive-card-soon {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }

  /* Newsletter dole: plochý pruh, stejně jako na úvodní stránce */
  .archive-newsletter {
    padding: var(--space-xl) 0;
    background: var(--color-band);
  }
  .archive-newsletter-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }
  .archive-newsletter-inner h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    margin-bottom: var(--space-xs);
  }
  .archive-newsletter-inner p {
    max-width: 520px;
    line-height: 1.6;
  }
  .archive-newsletter-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 50px;
    padding: 0.8rem 1.4rem;
    background: var(--color-accent-bg);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }
  .archive-newsletter-btn:hover {
    color: #fff;
    background: color-mix(in srgb, var(--color-accent-bg) 82%, #000);
  }

  @media (max-width: 900px) {
    .archive-card { grid-template-columns: 1fr; }
    .card-cover, .card-shot { min-height: 200px; }
    .archive-card-body { padding: var(--space-md); }
    .archive-newsletter-inner { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 640px) {
    .card-cover, .card-shot { min-height: 170px; }
    .archive-card-body h2 { font-size: 1.25rem; }
    .archive-card-cta { min-height: 44px; }
    .archive-newsletter-btn { width: 100%; justify-content: center; }
  }
</style>

<script is:inline>
  (function() {
    var buttons = document.querySelectorAll('.filter-tag');
    var cards = document.querySelectorAll('.archive-card');
    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var tag = btn.getAttribute('data-tag');
        buttons.forEach(function(b) { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        cards.forEach(function(card) {
          var tags = (card.getAttribute('data-tags') || '').split(',');
          card.classList.toggle('hidden', tag !== 'all' && tags.indexOf(tag) === -1);
        });
      });
    });
  })();
</script>
