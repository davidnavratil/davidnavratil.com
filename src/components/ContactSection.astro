---
import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
---

<!-- Stejný jazyk jako poptávka na /prednasky: tmavý pruh přes celou šířku, hranatá pole, bez rámečkových tlačítek. -->
<section class="contact contact--full" id="contact">
  <div class="container contact-card reveal">
    <div class="contact-grid">
      <div class="contact-info">
        <p class="contact-eyebrow">{Astro.currentLocale === 'en' ? 'Contact' : 'Kontakt'}</p>
        <h2 set:html={t('contact.title')} />
        <p>{t('contact.desc')}</p>
        <p class="contact-links">
          <a href="mailto:davidxnavratil@gmail.com">davidxnavratil@gmail.com</a>
          <span aria-hidden="true">·</span>
          <a href="https://davidnavratil.substack.com" target="_blank" rel="noopener">{t('contact.newsletter')}</a>
          <span aria-hidden="true">·</span>
          <a href="https://www.linkedin.com/in/david-navratil/" target="_blank" rel="noopener">{t('contact.linkedin')}</a>
        </p>
      </div>
      <form
        action="/api/poptavka"
        method="POST"
        class="contact-form"
        data-dn-form
        data-msg-sending={t('form.sending')}
        data-msg-ok={t('form.success')}
        data-msg-error={t('form.error')}
      >
        {/* Zprávy přijímá vlastní server (server/poptavky/), ne Formspree. */}
        <input type="hidden" name="zdroj" value="kontakt" />
        <input type="hidden" name="locale" value={Astro.currentLocale ?? 'cs'} />
        {/* Past na roboty: lidé pole nevidí; vyplněná zpráva přijde označená „[ověřit]“. */}
        <input
          type="text"
          name="_gotcha"
          class="form-honeypot"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <div class="form-row">
          <label>
            <span>{t('form.name')}</span>
            <input type="text" name="name" required />
          </label>
          <label>
            <span>{t('form.email')}</span>
            <input type="email" name="email" required />
          </label>
        </div>
        <label>
          <span>{t('form.company')}</span>
          <input type="text" name="company" />
        </label>
        <label>
          <span>{t('form.message')}</span>
          <textarea name="message" rows="4" required></textarea>
        </label>
        <button type="submit" class="form-submit">
          <span class="form-submit__label">{t('form.submit')}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
        {Astro.currentLocale !== 'en' && (
          <p class="form-privacy">Údaje z&nbsp;formuláře použiji jen k&nbsp;odpovědi na vaši zprávu. Zprávy se ukládají na serveru webu a&nbsp;doručují přes Gmail (Google). O&nbsp;výmaz můžete kdykoli požádat na davidxnavratil@gmail.com.</p>
        )}
        <p class="form-status" role="status" aria-live="polite" hidden></p>
        <noscript>
          <p class="form-status" data-state="error">{t('form.noscript')}</p>
        </noscript>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    background: #102d47;
    color: #f5f1e8;
    padding: var(--space-2xl) 0;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-xl);
    align-items: start;
  }
  .contact-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #8dd4cb;
    margin-bottom: var(--space-sm);
  }
  .contact-info h2 {
    color: #f5f1e8;
    font-size: clamp(2rem, 3.4vw, 2.9rem);
    margin-bottom: var(--space-md);
  }
  .contact-info > p:not(.contact-eyebrow):not(.contact-links) {
    color: #c4d0d8;
    line-height: 1.6;
    max-width: 380px;
  }
  .contact-links {
    margin-top: var(--space-lg);
    padding-top: var(--space-sm);
    border-top: 1px solid #3c5365;
    font-size: 0.85rem;
    color: #c4d0d8;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .contact-links a {
    color: #f5f1e8;
    font-weight: 600;
    text-decoration: none;
  }
  .contact-links a:hover {
    color: #8dd4cb;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .form-privacy { margin: 0; font-size: 0.75rem; line-height: 1.5; color: #b9cbd7; }
  .form-privacy a { color: inherit; text-decoration: underline; }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .contact-form label span {
    font-size: 0.75rem;
    color: #f5f1e8;
  }
  .contact-form input,
  .contact-form textarea {
    min-height: 48px;
    padding: 0.7rem;
    border-radius: 0 !important;
    border: 1px solid #647c8d;
    background: #1b3a52;
    color: #f5f1e8;
    font-size: 0.9rem;
    font-family: inherit;
    color-scheme: dark;
    transition: border-color 0.2s;
    resize: vertical;
  }
  .contact-form textarea { min-height: 120px; }
  .contact-form input:focus-visible,
  .contact-form textarea:focus-visible {
    outline: 2px solid #8dd4cb;
    outline-offset: 1px;
    border-color: #8dd4cb;
  }
  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: #acbcc7;
  }
  .form-submit {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    min-height: 50px;
    padding: 0.8rem 1.3rem;
    border: none;
    background: var(--color-accent-bg);
    color: #fff;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.2s;
    width: fit-content;
  }
  .form-submit:hover {
    background: #135E69;
  }
  .form-submit[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  /* Off-screen spam trap. Not display:none — some bots skip hidden fields. */
  .form-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .form-status {
    margin: 0;
    padding: 0.65rem 0.85rem;
    font-size: 0.9rem;
    line-height: 1.5;
    border: 1px solid transparent;
  }
  .form-status[data-state='ok'] {
    color: #D8F3E4;
    background: rgba(45, 160, 110, 0.15);
    border-color: rgba(45, 160, 110, 0.45);
  }
  .form-status[data-state='error'] {
    color: #FBDCD5;
    background: rgba(200, 70, 45, 0.15);
    border-color: rgba(200, 70, 45, 0.45);
  }
  .form-status[data-state='sending'] {
    color: #c4d0d8;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  @media (max-width: 640px) {
    .contact { padding: var(--space-xl) 0; }
    .form-row { grid-template-columns: 1fr; }
    .form-submit {
      width: 100%;
      justify-content: center;
    }
    .contact-form input,
    .contact-form textarea {
      font-size: 1rem;
    }
  }
</style>
