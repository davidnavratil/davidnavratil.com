---
import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <a href={Astro.currentLocale === 'en' ? '/en/' : '/'} class="footer-mark">David Navrátil</a>
      <p>&copy; {year}</p>
    </div>
    <div class="footer-links">
      {Astro.currentLocale === 'en' ? (
        <>
          <a href="/en/megatrendy/">Megatrends</a>
          <a href="/en/analyses/">Analyses</a>
          <a href="/en/prednasky/">Speaking</a>
          <a href="/en/pro-poradatele/">For organisers and press</a>
          <a href="/en/#about">About</a>
          <a href="/en/#contact">Contact</a>
        </>
      ) : (
        <>
          <a href="/megatrendy/">Megatrendy</a>
          <a href="/analyses/">Analýzy</a>
          <a href="/prednasky/">Přednášky</a>
          <a href="/pro-poradatele/">Pro pořadatele a&nbsp;novináře</a>
          <a href="/#about">O mně</a>
          <a href="/#contact">Kontakt</a>
        </>
      )}
      <a href="https://davidnavratil.substack.com" target="_blank" rel="noopener">Substack</a>
      <a href="https://www.linkedin.com/in/david-navratil/" target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-xl);
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .footer-left {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .footer-mark {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
  }
  .footer-mark:hover { color: var(--color-accent); }
  .footer-left p {
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .footer-links {
    display: flex;
    gap: var(--space-md);
  }
  .footer-links a {
    font-size: 0.85rem;
    color: var(--color-muted);
    transition: color 0.2s;
  }
  .footer-links a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .footer-inner { flex-direction: column; gap: var(--space-sm); }
  }
  .footer-links { flex-wrap: wrap; row-gap: 0.4rem; min-width: 0; }
  @media (max-width: 640px) { .footer-inner { flex-direction: column; align-items: flex-start; gap: 1rem; } }
</style>
