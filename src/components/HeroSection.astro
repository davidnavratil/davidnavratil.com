---
import { useTranslations } from '../i18n/utils';
import mapaHero from '../data/mapa-hero.svg?raw';

const t = useTranslations(Astro.currentLocale);
const en = Astro.currentLocale === 'en';
const doors = [
  { key: 'explore', href: en ? '#analyzy' : '/megatrendy/' },
  { key: 'invite', href: en ? '#speaking' : '/prednasky/' },
  { key: 'read', href: '#newsletter' },
];
---

<section class="hero">
  <div class="hero-bg">
    {/* Film na pozadí úvodu: tiché záběry bez textu, ztmavené, aby nadpis zůstal čitelný. Jen na širokých
        obrazovkách a jen když si čtenář nepřeje omezit pohyb (spouští ho skript níže). */}
    {!en && <video class="hero-video" muted playsinline loop preload="none" aria-hidden="true" tabindex="-1" data-src="/video/uvod-pozadi.mp4"></video>}
    <div class="hero-shade"></div>
    <div class="grid-pattern"></div>
    <div class="hero-glow"></div>
  </div>
  {!en && <button type="button" class="hero-video-toggle" hidden aria-pressed="true">Pozastavit pozadí</button>}
  <div class="hero-inner">
    <div class="hero-grid">
      <div class="hero-content">
        <span class="hero-eyebrow">{t('hero.eyebrow')}</span>
        <h1 class="hero-title" set:html={t('hero.title')} />
        <p class="hero-sub">{t('hero.sub')}</p>
        {/*
          Who he is, on the first screen. Previously "hlavní ekonom České
          spořitelny" appeared only in the About section, seven screens down,
          so a visitor arriving from LinkedIn never saw the one credential
          that does most of the work.
        */}
        <p class="hero-identity">{t('hero.identity')}</p>
      </div>
      <div class="hero-preview">
        {en ? (
          <img
            src="/images/preview-hormuz.webp"
            alt="Analysis preview: Strait of Hormuz simulator"
            width="560"
            height="380"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          /* Slib „Mapa světa…“ vedle skutečné mapy: 76 sil katalogu a vazby mezi nimi (generuje gen_mapa.py). */
          <a href="/megatrendy/" class="hero-map">
            <Fragment set:html={mapaHero} />
            <span class="hero-map-cap"><strong>76&nbsp;sil a&nbsp;276&nbsp;vazeb</strong>, výhled do roku 2031 · Prohlédnout mapu <span aria-hidden="true">→</span></span>
          </a>
        )}
      </div>
    </div>
    {/* Jeden slib (nadpis) a troje dveře: každé pro jiného návštěvníka (čtenář, pořadatel, vedení firmy, novinář). */}
    <nav class="doors" aria-label={t('doors.label')}>
      {doors.map((d) => (
        <a href={d.href} class="door">
          <span class="door-kicker">{t(`doors.${d.key}.kicker`)}</span>
          <strong class="door-title">{t(`doors.${d.key}.title`)}</strong>
          <span class="door-text">{t(`doors.${d.key}.text`)}</span>
          <span class="door-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>
  </div>
</section>

<script is:inline>
  (function () {
    var v = document.querySelector('.hero-video'); if (!v) return;
    var ok = window.matchMedia('(min-width: 901px)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!ok || (navigator.connection && navigator.connection.saveData)) return;
    v.src = v.dataset.src;
    v.addEventListener('canplay', function () { v.classList.add('on'); }, { once: true });
    var p = v.play(); if (p && p.catch) p.catch(function () {});
    var b = document.querySelector('.hero-video-toggle');
    if (b) { b.hidden = false; b.addEventListener('click', function () { if (v.paused) { v.play(); b.textContent = 'Pozastavit pozadí'; b.setAttribute('aria-pressed', 'true'); } else { v.pause(); b.textContent = 'Spustit pozadí'; b.setAttribute('aria-pressed', 'false'); } }); }
  })();
</script>

<style>
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.2s ease; }
  .hero-video.on { opacity: 1; }
  .hero-video-toggle { position: absolute; right: 18px; bottom: 14px; z-index: 2; padding: 6px 12px; border: 1px solid rgba(255,255,255,.35); background: rgba(7,18,29,.55); color: #fff; font: 600 12px var(--font-sans); cursor: pointer; border-radius: 3px; }
  .hero-video-toggle:hover, .hero-video-toggle:focus-visible { border-color: #fff; outline: none; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(13, 37, 61, 0.93) 0%, rgba(13, 37, 61, 0.84) 55%, rgba(13, 37, 61, 0.74) 100%); }

  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--gradient-hero);
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    padding: 6rem 0 4rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .grid-pattern {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 30%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 30%, transparent 70%);
  }

  .hero-glow {
    position: absolute;
    top: 10%;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 500px;
    background: radial-gradient(ellipse, rgba(212, 135, 74, 0.10) 0%, transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(212, 135, 74, 0.08), transparent 40%);
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .hero:hover::after {
    opacity: 1;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-lg, 2rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 55% 45%;
    gap: var(--space-xl, 3rem);
    align-items: center;
  }

  .hero-content {
    max-width: 600px;
  }

  .hero-eyebrow {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8dd4cb;
    margin-bottom: var(--space-md, 1.5rem);
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: #ffffff;
    margin-bottom: var(--space-md, 1.5rem);
  }
  .hero-title :global(em) { color: #8dd4cb; }

  .hero-sub {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
    max-width: 520px;
    margin-bottom: var(--space-sm, 0.75rem);
  }
  /* Slightly brighter than .hero-sub so the credential reads before the prose. */
  .hero-identity {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.6;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    max-width: 520px;
    margin-bottom: var(--space-lg, 2rem);
  }

  .hero-cta {
    display: flex;
    gap: var(--space-sm, 0.75rem);
    flex-wrap: wrap;
    margin-bottom: var(--space-sm, 0.75rem);
  }

  .hero-microcopy {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.55);
    max-width: 440px;
  }

  /* Preview image */
  .hero-preview {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-preview img {
    width: 100%;
    max-width: 520px;
    height: auto;
    max-height: 400px;
    object-fit: cover;
    object-position: top left;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35), 0 8px 20px rgba(0, 0, 0, 0.2);
  }

  /* Buttons */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    background: var(--gradient-accent);
    color: white;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 15px rgba(160, 90, 44, 0.3);
    text-decoration: none;
  }
  .btn-primary:hover {
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(160, 90, 44, 0.4);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.95rem;
    transition: border-color 0.2s, background 0.2s;
    text-decoration: none;
  }
  .btn-secondary:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.06);
  }

  /* Mapa sil v úvodu: vazby se při načtení postupně vykreslí, body naskočí (bez animace, když si to čtenář nepřeje) */
  .hero-map {
    position: relative;
    display: block;
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
    color: #ffffff;
    text-decoration: none;
  }
  .hero-map :global(.hm-svg) { display: block; width: 100%; height: auto; overflow: visible; }
  .hero-map :global(.hm-e) { stroke-width: 1; stroke-opacity: 0.34; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .hero-map :global(.hm-s) { stroke-width: 1.8; stroke-opacity: 0.7; }
  .hero-map :global(.hm-a) { opacity: 0.95; }
  .hero-map-cap {
    display: block;
    margin-top: 0.9rem;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.72);
  }
  .hero-map-cap strong { color: #ffffff; font-weight: 600; }
  .hero-map:hover .hero-map-cap { color: #ffffff; }
  .hero-map:hover :global(.hm-e) { stroke-opacity: 0.55; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-map :global(.hm-e) { stroke-dashoffset: 1; animation: hm-draw 1.8s cubic-bezier(.3,.6,.3,1) forwards; animation-delay: calc(0.4s + var(--i) * 14ms); }
    .hero-map :global(.hm-n) { opacity: 0; animation: hm-in 0.5s ease-out forwards; animation-delay: calc(var(--j) * 9ms); }
    .hero-map :global(.hm-a) { opacity: 0; animation: hm-in 0.8s ease-out 0.2s forwards; }
  }
  @keyframes hm-draw { to { stroke-dashoffset: 0; } }
  @keyframes hm-in { to { opacity: 0.95; } }

  /* Troje dveře pod slibem */
  .doors {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md, 1.5rem);
    margin-top: var(--space-xl, 3rem);
  }
  .door {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 3rem 1.35rem 1.35rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .door:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.09);
    transform: translateY(-2px);
  }
  .door-kicker {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8dd4cb;
  }
  .door-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .door-text {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.72);
  }
  .door-arrow {
    position: absolute;
    right: 1.2rem;
    top: 1.2rem;
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.6);
    transition: transform 0.2s;
  }
  .door:hover .door-arrow { transform: translateX(3px); color: #ffffff; }
  @media (max-width: 900px) {
    .doors { grid-template-columns: 1fr; gap: 0.75rem; text-align: left; }
  }

  /* Mobile */
  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding: 5rem 0 3rem;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .hero-content {
      max-width: 100%;
    }
    .hero-eyebrow {
      margin-inline: 0;
    }
    .hero-sub {
      margin-inline: 0;
    }
    .hero-identity {
      margin-inline: 0;
    }
    .hero-cta {
      justify-content: center;
    }
    .hero-microcopy {
      margin-inline: 0;
    }
    .hero-inner { display: flex; flex-direction: column; }
    .hero-grid { display: contents; }
    .hero-content { order: 1; text-align: left; }
    .hero-identity { margin-bottom: 0; }
    .doors { order: 2; margin-top: var(--space-md, 1.5rem); }
    .hero-preview { order: 3; margin-top: var(--space-lg, 2rem); }
    .hero-preview img {
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .hero {
      /* The fixed header is ~75px tall here, so the old 4rem (64px) let it
         cover the first line of the eyebrow at scroll position 0. */
      padding: 7rem 0 2.5rem;
    }
    .hero-inner {
      padding: 0 var(--space-sm, 1rem);
    }
    .hero-title {
      font-size: clamp(1.9rem, 7.4vw, 2.3rem);
    }
    .btn-primary,
    .btn-secondary {
      min-height: 44px;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 400px) {
    .hero {
      padding: 6.5rem 0 2rem;
    }
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-primary,
    .btn-secondary {
      justify-content: center;
      width: 100%;
      text-align: center;
    }
  }
</style>

<script is:inline>
  // Mouse-tracking glow on hero
  (function() {
    var hero = document.querySelector('.hero');
    if (!hero || window.matchMedia('(pointer: coarse)').matches) return;
    hero.addEventListener('mousemove', function(e) {
      var rect = hero.getBoundingClientRect();
      var x = ((e.clientX - rect.left) / rect.width * 100).toFixed(1);
      var y = ((e.clientY - rect.top) / rect.height * 100).toFixed(1);
      hero.style.setProperty('--mouse-x', x + '%');
      hero.style.setProperty('--mouse-y', y + '%');
    });
  })();
</script>
