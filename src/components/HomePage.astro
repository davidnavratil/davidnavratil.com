---
import Base from '../layouts/Base.astro';
import HeroSection from './HeroSection.astro';
import TrustBar from './TrustBar.astro';
import AnalysesSection from './AnalysesSection.astro';
import WhyPeopleReturn from './WhyPeopleReturn.astro';
import NewsletterCTA from './NewsletterCTA.astro';
import LatestArticles from './LatestArticles.astro';
import AboutSection from './AboutSection.astro';
import SpeakingSection from './SpeakingSection.astro';
import ContactSection from './ContactSection.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
---

<Base title={t('meta.title')} description={t('meta.description')}>

  <HeroSection />
  <TrustBar />
  <AnalysesSection />
  <WhyPeopleReturn />
  <NewsletterCTA />
  <LatestArticles />
  <AboutSection />
  <SpeakingSection />
  <ContactSection />

</Base>

<style is:global>
  /* ===== BAND (alternating bg) ===== */
  .band {
    background: var(--color-band);
  }

  /* ===== SCROLL ANIMATIONS =====
     Opt-in, not opt-out: content is visible by default and only hidden once
     the script below confirms it can reveal it again. Previously `.reveal`
     was opacity:0 in the stylesheet, so with JavaScript off or broken the
     entire page below the hero rendered blank. */
  .js-reveal .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .js-reveal .reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }

  /* Respect the OS-level motion preference. */
  @media (prefers-reduced-motion: reduce) {
    .js-reveal .reveal,
    .js-reveal .reveal.in-view {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script is:inline>
  // Scroll-triggered reveal animations
  (function() {
    var els = document.querySelectorAll('.reveal');
    if (!els.length) return;
    // Bail out before hiding anything if the browser can't observe, or if the
    // reader asked for reduced motion. Adding the class is what arms the CSS.
    if (!('IntersectionObserver' in window)) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduce && reduce.matches) return;
    document.documentElement.classList.add('js-reveal');
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          e.target.classList.add('in-view');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    els.forEach(function(el) { observer.observe(el); });
  })();
</script>
