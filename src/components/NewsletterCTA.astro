---
import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const values = (['newsletter.value1', 'newsletter.value2', 'newsletter.value3', 'newsletter.value4', 'newsletter.value5'] as const)
  .map((k) => t(k))
  .filter(Boolean);
---

<!-- Plochý pruh přes celou šířku, stejný jazyk jako sekce Přednášky: bez přechodů, záře a fajfek. -->
<section class="newsletter band" id="newsletter">
  <div class="container newsletter-grid reveal">
    <div class="newsletter-copy">
      <div class="section-tag">Newsletter</div>
      <h2 class="newsletter-heading" set:html={t('newsletter.title')} />
      <p class="newsletter-lead">{t('newsletter.desc')}</p>
    </div>
    <div class="newsletter-side">
      <ul class="newsletter-values">
        {values.map((v) => <li>{v}</li>)}
      </ul>
      <a href="https://davidnavratil.substack.com/subscribe" target="_blank" rel="noopener" class="newsletter-btn">
        {t('newsletter.cta')}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <p class="newsletter-note">{t('newsletter.note')}</p>
    </div>
  </div>
</section>

<style>
  .newsletter {
    padding: var(--space-2xl) 0;
    margin-bottom: var(--space-2xl);
  }
  .newsletter-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }
  .section-tag {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-section-tag);
    margin-bottom: var(--space-sm);
  }
  .newsletter-heading {
    font-family: var(--font-serif);
    margin-bottom: var(--space-sm);
  }
  .newsletter-lead {
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 460px;
  }
  .newsletter-values {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-md);
    border-top: 1px solid var(--color-border);
  }
  .newsletter-values li {
    padding: 0.7rem 0 0.7rem 1.4rem;
    border-bottom: 1px solid var(--color-border);
    position: relative;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--color-text);
  }
  .newsletter-values li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }
  .newsletter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 50px;
    padding: 0.8rem 1.4rem;
    background: var(--color-accent-bg);
    color: #fff;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background 0.2s;
  }
  .newsletter-btn:hover {
    color: #fff;
    background: color-mix(in srgb, var(--color-accent-bg) 82%, #000);
  }
  .newsletter-note {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: var(--space-xs);
  }

  @media (max-width: 900px) {
    .newsletter-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
  @media (max-width: 640px) {
    .newsletter {
      padding: var(--space-xl) 0;
    }
    .newsletter-btn {
      width: 100%;
      justify-content: center;
      min-height: 48px;
    }
  }
</style>
